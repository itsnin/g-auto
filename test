sudo python3 -c "
path = '/usr/share/gnome-shell/js/ui/extensionDownloader.js'
with open(path, 'r') as f:
    c = f.read()
old = c[c.find('_confirmInstall(extension) {'):c.find('_confirmInstall(extension) {')+2000]
brace=0; found=False; start=c.find('_confirmInstall(extension) {')
for i in range(start, len(c)):
    if c[i]=='{': brace+=1; found=True
    elif c[i]=='}':
        brace-=1
        if found and brace==0: end=i+1; break
c = c[:start] + '_confirmInstall(extension) { this._installExtension(extension); }' + c[end:]
with open(path, 'w') as f:
    f.write(c)
print('PATCHED')
" && echo "Now press Alt+F2, type 'r', press Enter to restart GNOME Shell"
