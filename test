TARGET=$(grep -rl "_confirmInstall" /usr/share/gnome-shell/ 2>/dev/null | head -1)
echo "Found: $TARGET"
if [ -n "$TARGET" ]; then
  sudo python3 -c "
path = '$TARGET'
with open(path, 'r') as f:
    c = f.read()
brace=0; found=False; start=c.find('_confirmInstall(extension) {')
for i in range(start, len(c)):
    if c[i]=='{': brace+=1; found=True
    elif c[i]=='}':
        brace-=1
        if found and brace==0: end=i+1; break
c = c[:start] + '_confirmInstall(extension) { this._installExtension(extension); }' + c[end:]
with open(path, 'w') as f:
    f.write(c)
print('PATCHED')
"
  echo "Now press Alt+F2, type 'r', press Enter"
else
  echo "File not found in /usr/share/gnome-shell. Searching system-wide..."
  grep -rl "_confirmInstall" /usr/ 2>/dev/null | head -5
fi
